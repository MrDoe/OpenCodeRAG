{
  "name": "opencode-rag-plugin",
  "version": "1.19.0",
  "description": "OpenCode plugin for local-first RAG-based semantic code search",
  "type": "module",
  "main": "./dist/plugin-entry.js",
  "module": "./dist/plugin-entry.js",
  "types": "./dist/plugin-entry.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin-entry.js",
      "require": "./dist/plugin-entry.js",
      "types": "./dist/plugin-entry.d.ts"
    },
    "./server": {
      "import": "./dist/plugin-entry.js",
      "require": "./dist/plugin-entry.js",
      "types": "./dist/plugin-entry.d.ts"
    },
    "./library": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./ui": {
      "import": "./dist/web/server.js",
      "types": "./dist/web/server.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    }
  },
  "files": [
    "dist",
    "wasm",
    "scripts/postinstall-setup.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-rag": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config src/web/ui/vite.config.ts",
    "build:ui": "vite build --config src/web/ui/vite.config.ts",
    "dev:ui": "vite --config src/web/ui/vite.config.ts",
    "postinstall": "node scripts/postinstall-setup.js",
    "postbuild": "node scripts/postbuild.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"const {spawnSync}=require('node:child_process');const {globSync}=require('node:fs');const testFiles=globSync('src/**/*.test.ts').filter(f=>!f.includes('integration.test.ts')&&f!=='src/__tests__/plugin.test.ts'&&f!=='src/__tests__/watcher/integration.test.ts');if(testFiles.length===0){console.log('No test files found under src; skipping npm test.');process.exit(0);}const result=spawnSync(process.execPath,['--import','tsx','--test',...testFiles],{stdio:'inherit'});process.exit(typeof result.status==='number'?result.status:1);\"",
    "test:integration": "node -e \"const {spawnSync}=require('node:child_process');const testFiles=['src/__tests__/integration.test.ts','src/__tests__/plugin.test.ts','src/__tests__/watcher/integration.test.ts'];const result=spawnSync(process.execPath,['--import','tsx','--test',...testFiles],{stdio:'inherit'});process.exit(typeof result.status==='number'?result.status:1);\"",
    "cli": "tsx src/cli/index.ts",
    "release:patch": "node ./scripts/release-patch.js",
    "release:minor": "node ./scripts/release-minor.js"
  },
  "keywords": [
    "opencode",
    "rag",
    "code-search",
    "embeddings",
    "vector-search",
    "semantic-search",
    "plugin",
    "ai",
    "code"
  ],
  "author": "Christoph Döllinger <christoph.doellinger@med.uni-heidelberg.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrDoe/OpenCodeRAG.git"
  },
  "bugs": {
    "url": "https://github.com/MrDoe/OpenCodeRAG/issues"
  },
  "homepage": "https://github.com/MrDoe/OpenCodeRAG#readme",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@lancedb/lancedb": "^0.29.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@preact/signals": "^2.10.0",
    "@thednp/dommatrix": "^3.0.4",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "apache-arrow": "18.1.0",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.12.0",
    "minimatch": "^8.0.7",
    "p-limit": "^7.3.0",
    "pdfjs-dist": "^5.7.284",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.2",
    "web-tree-sitter": "^0.26.9",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.15.5",
    "@opentui/core": "^0.4.0",
    "@opentui/keymap": "^0.4.0",
    "@opentui/solid": "^0.4.0",
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/word-extractor": "^1.0.6",
    "autoprefixer": "^10.5.0",
    "highlight.js": "^11.9.0",
    "postcss": "^8.5.15",
    "preact": "^10.25.4",
    "solid-js": "1.9.12",
    "tailwindcss": "^3.4.19",
    "tree-sitter-cli": "^0.26.9",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "web-tree-sitter": "$web-tree-sitter"
  },
  "allowScripts": {
    "opencode-rag-plugin": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "tree-sitter-cli": true
  }
}
